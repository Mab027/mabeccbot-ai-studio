/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://cal.com https://app.cal.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://app.cal.com; frame-src https://app.cal.com https://cal.com; connect-src 'self' https://app.cal.com https://api.cal.com https://cal.com

/assets/*
  Cache-Control: public, max-age=604800, immutable
